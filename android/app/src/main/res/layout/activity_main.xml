<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.infosphere.app.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD : compteurs et coordonnées -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/hud_gradient">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/countCell"
                style="@style/HudText"
                android:textColor="@color/cell"
                android:layout_marginEnd="14dp" />

            <TextView
                android:id="@+id/countWifi"
                style="@style/HudText"
                android:textColor="@color/wifi"
                android:layout_marginEnd="14dp" />

            <TextView
                android:id="@+id/countSat"
                style="@style/HudText"
                android:textColor="@color/sat" />
        </LinearLayout>

        <TextView
            android:id="@+id/coords"
            style="@style/HudText"
            android:text="@string/coords_unknown"
            android:alpha="0.6"
            android:layout_marginTop="2dp"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/compass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="96dp"
        android:layout_marginEnd="16dp"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:alpha="0.7" />

    <!-- Fiche d'information d'un signal -->
    <FrameLayout
        android:id="@+id/infoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:layout_marginBottom="64dp"
        android:background="@drawable/info_card_bg"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:paddingEnd="48dp">

            <TextView
                android:id="@+id/infoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/infoDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:alpha="0.85"
                android:lineSpacingMultiplier="1.3" />
        </LinearLayout>

        <TextView
            android:id="@+id/infoClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:gravity="center"
            android:text="@string/close"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:alpha="0.7" />
    </FrameLayout>

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:text="@string/hint"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:alpha="0.55" />

    <!-- Écran d'accueil -->
    <LinearLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg"
        android:gravity="start"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="180dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/splash_subtitle"
            android:textColor="@color/accent"
            android:textSize="20sp"
            android:lineSpacingMultiplier="1.3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/splash_explain"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:alpha="0.7"
            android:lineSpacingMultiplier="1.4" />

        <Button
            android:id="@+id/startBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:text="@string/explore"
            android:textColor="@color/bg"
            android:backgroundTint="@color/ink" />
    </LinearLayout>
</FrameLayout>
